{
    "name": "buildagents/agent-engine",
    "description": "Integração Laravel com o serviço de agentes: tabelas, models, execução e webhook reutilizáveis.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["laravel", "agents", "ai", "llm"],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.5",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "BuildAgents\\AgentEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BuildAgents\\AgentEngine\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "BuildAgents\\AgentEngine\\AgentEngineServiceProvider"
            ],
            "aliases": {
                "AgentEngine": "BuildAgents\\AgentEngine\\Facades\\AgentEngine"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
